{
  "text-color": "#cdeed6",
  "background-color": "#0c1510",
  "line-number-color": "#4f6b58",
  "line-number-background-color": null,
  "text-styles": {
    "Normal": { "text-color": "#cdeed6" },
    "Keyword": { "text-color": "#7ee2a0", "bold": true },
    "ControlFlow": { "text-color": "#7ee2a0", "bold": true },
    "DataType": { "text-color": "#9fd8ff" },
    "DecVal": { "text-color": "#f0d27a" },
    "BaseN": { "text-color": "#f0d27a" },
    "Float": { "text-color": "#f0d27a" },
    "Constant": { "text-color": "#f0d27a" },
    "Char": { "text-color": "#e3f5a6" },
    "SpecialChar": { "text-color": "#e3f5a6" },
    "String": { "text-color": "#e3f5a6" },
    "VerbatimString": { "text-color": "#e3f5a6" },
    "SpecialString": { "text-color": "#e3f5a6" },
    "Import": { "text-color": "#7ee2a0" },
    "Comment": { "text-color": "#78977f", "italic": true },
    "Documentation": { "text-color": "#78977f", "italic": true },
    "Annotation": { "text-color": "#78977f", "italic": true },
    "CommentVar": { "text-color": "#78977f", "italic": true },
    "Other": { "text-color": "#9fd8ff" },
    "Function": { "text-color": "#9fd8ff" },
    "Variable": { "text-color": "#cdeed6" },
    "Operator": { "text-color": "#a9c9b3" },
    "BuiltIn": { "text-color": "#9fd8ff" },
    "Extension": { "text-color": "#7ee2a0" },
    "Preprocessor": { "text-color": "#7ee2a0" },
    "Attribute": { "text-color": "#9fd8ff" },
    "Region": { "text-color": "#cdeed6" },
    "Information": { "text-color": "#f0d27a" },
    "Warning": { "text-color": "#f0d27a" },
    "Alert": { "text-color": "#ff9b8f", "bold": true },
    "Error": { "text-color": "#ff9b8f", "underline": true }
  }
}
